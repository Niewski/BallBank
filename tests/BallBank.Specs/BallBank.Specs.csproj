<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executable specifications in league language (Gherkin), run with Reqnroll on xUnit. The treasury
       specs run against the aggregates in memory by default, or against the API over HTTP with
       BALLBANK_SPECS_DRIVER=http (PostgreSQL through Testcontainers, so Docker must be running). -->

  <PropertyGroup>
    <RootNamespace>BallBank.Specs</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- Reqnroll resolves the en-US culture for feature files; invariant globalization forbids that. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BallBank.Api\BallBank.Api.csproj" />
    <ProjectReference Include="..\..\src\BallBank.Domain\BallBank.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The HTTP driver hosts the API exactly as the integration tests do: their test issuer, their fake Sleeper and its fixtures. -->
  <ItemGroup>
    <Compile Include="..\BallBank.Integration.Tests\Http\BallBankApi.cs" Link="Support\Shared\BallBankApi.cs" />
    <Compile Include="..\BallBank.Integration.Tests\Http\Telemetry.cs" Link="Support\Shared\Telemetry.cs" />
    <Compile Include="..\BallBank.Integration.Tests\Http\TestClock.cs" Link="Support\Shared\TestClock.cs" />
    <Compile Include="..\BallBank.Integration.Tests\Sleeper\FakeSleeper.cs" Link="Support\Shared\FakeSleeper.cs" />
    <None Include="..\BallBank.Integration.Tests\Sleeper\Fixtures\*.json" Link="Sleeper\Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
