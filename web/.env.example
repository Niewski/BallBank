# Copy to .env.local for local development outside Aspire.
# When run through the Aspire AppHost these are injected automatically.
NEXT_PUBLIC_API_URL=https://localhost:7213

# The Auth0 single-page application and the API audience (see the root README).
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.ballbank.local
